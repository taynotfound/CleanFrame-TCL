<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Online wallpaper sources (NASA, Bing, Wikimedia, Picsum, Unsplash), and the Home Assistant add-on on the home network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updates: hands a verified release APK to Android's installer, which asks the owner to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Continue watching: reads the rows apps publish to the system's Watch Next list. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Beat pulse in the music view: Android's Visualizer reads the TV's mixed output (never the microphone) but requires these. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: only launchable apps and icon packs, no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Icon packs (ADW/Nova/Projectivy format): Shore reads their appfilter.xml and drawables. -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.spocky.projengmenu.icons.ACTION_PICK_ICON" /></intent>
    </queries>

    <application
        android:label="Shore"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/CleanFrame">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Lets CleanFrame act as the Home app where the TV allows it (see docs/android-tv.md). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Answers from the package installer for in-app updates. -->
        <receiver android:name=".Updater$Status" android:exported="false" />

        <!-- Optional: routes the remote's Home button to CleanFrame (Google TV ignores the default-home setting). -->
        <service
            android:name=".HomeButtonService"
            android:label="@string/home_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_button_service" />
        </service>

        <!-- Optional: reads the active media sessions for the "Now playing" line (Notification access, enabled by the user). -->
        <service
            android:name=".NowPlayingService"
            android:label="@string/now_playing_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Optional: Shore's screensaver as the TV's system screensaver, where the TV lets the owner choose one. -->
        <service
            android:name=".ShoreDream"
            android:label="@string/screensaver_label"
            android:permission="android.permission.BIND_DREAM_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
