<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backups and device transfers: everything except the Home Assistant token and the ad blocker password. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="homeassistant.xml" />
        <exclude domain="sharedpref" path="adblock.xml" />
        <exclude domain="sharedpref" path="phone-upload.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="homeassistant.xml" />
        <exclude domain="sharedpref" path="adblock.xml" />
        <exclude domain="sharedpref" path="phone-upload.xml" />
    </device-transfer>
</data-extraction-rules>
