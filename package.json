{
  "name": "cleanframe",
  "version": "0.6.1",
  "private": true,
  "description": "Shore: a plainer home screen for Android TV and Google TV.",
  "scripts": {
    "dev": "python3 scripts/preview.py",
    "check": "node --check app/main.js && node --check app/device.js && node --check app/device-android.js && python3 scripts/check.py",
    "lint": "eslint .",
    "check:site": "node scripts/check-site.mjs",
    "check:docs": "python3 scripts/check-docs.py",
    "check:performance": "node scripts/check-performance.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "dev:public": "python3 scripts/preview.py --public-fonts",
    "check:public": "python3 scripts/check-public.py",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "playwright": "1.64.1"
  },
  "license": "MIT"
}
